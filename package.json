{
  "name": "beyin-duelleri",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-vars.mjs",
    "dev": "vite build && wrangler dev --test-scheduled",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "db:migrate:local": "wrangler d1 migrations apply beyin --local",
    "db:seed": "node scripts/seed.mjs",
    "db:unseed": "node scripts/seed.mjs --remove",
    "db:cron": "node scripts/cron.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "vite build && wrangler d1 migrations apply beyin --remote && wrangler deploy",
    "todo": "node scripts/todo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
